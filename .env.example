# Copy this file to .env.local and paste the Web app config from Firebase Console.
# These values are client-side Firebase identifiers, not service-account secrets.
VITE_FIREBASE_API_KEY=replace_me
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=replace_me
VITE_FIREBASE_APP_ID=replace_me
# URL Cloud Run WA Bot TimeKeeper, contoh: https://timekeeper-wa-bot-xxxxx.a.run.app
VITE_TIMEKEEPER_WA_API_URL=
