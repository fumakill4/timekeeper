rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /timekeeperSettings/{settingId} {
      allow read, write: if request.auth != null;
    }

    // Ditulis oleh WhatsApp Bot menggunakan Admin SDK. Browser hanya boleh membaca
    // setelah admin login; browser tidak boleh menulis langsung ke koleksi ini.
    match /timekeeperAttendance/{attendanceId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Master data is written by the WhatsApp Bot/Admin SDK. The web app is
    // intentionally read-only until role-based admin CRUD is enabled.
    match /timekeeperEmployees/{employeeId} {
      allow read, write: if request.auth != null;
    }

    match /timekeeperOutlets/{outletId} {
      allow read: if request.auth != null;
      // Outlet edit dari halaman admin membutuhkan update browser.
      // Penghapusan outlet tetap ditutup agar histori absensi tidak rusak.
      allow create, update: if request.auth != null;
      allow delete: if false;
    }

    // Other collections stay closed until their role-based rules are designed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
